# Settings for ./build.sh and ./release.sh. Plain KEY="value" lines; this file is read by bash.

# The app's identity. Do not change it after the first public release: macOS and Sparkle treat a different
# identifier as a different app.
BUNDLE_ID="com.aagicorp.feather"

# Where released copies of Feather look for updates. This address is baked into every copy you ship, so it must
# never change: keep the appcast on your own site for good, even after the downloads move to GitHub.
FEED_URL="https://feather.aagicorp.com/appcast.xml"

# The repository on GitHub whose Releases hold the DMGs ("owner/name"). tools/publish_release.sh creates a
# release there per version; the website and the update feed link to it.
GITHUB_REPO=""                    # e.g. aagicorp/feather

# Where the DMG files are downloaded from (the folder, ending in /). Worked out from GITHUB_REPO when empty.
DOWNLOAD_URL_PREFIX=""            # e.g. https://www.example.com/feather/

# The website lives in its own folder beside this repository: the GitHub repository aagicorp/feather-website,
# served by Cloudflare Pages at https://feather.aagicorp.com/. A release writes public/release.json and
# public/appcast.xml there.
WEBSITE_DIR="../FeatherWebsite"

# Local-only output that is never committed: team builds and the update lab (tools/update-lab.sh).
LOCAL_DIR="../Feather-local"

# What publishes the website after a release has written release.json and appcast.xml into WEBSITE_DIR: a push
# of the website repository, which Cloudflare Pages builds and deploys by itself.
DEPLOY_WEBSITE_COMMAND='cd "$WEBSITE_DIR" && git add public && git commit -m "Release $VERSION" && git push'

# Sparkle's public key, printed by "./release.sh setup". The private half stays in your login keychain.
SPARKLE_PUBLIC_KEY="qASm8uG+KxUM3+USWmnTL1vgnhutuMshZoD6bF1frJs="

# "Developer ID Application: Name (TEAMID)". Empty = the only Developer ID Application certificate in the keychain.
SIGN_IDENTITY=""

# The name given to "xcrun notarytool store-credentials" (see ./release.sh setup).
NOTARY_PROFILE="feather-notary"

# Optional: a command that publishes the folder releases/ (it runs with that folder as "$1"), for example
#   UPLOAD_COMMAND='rsync -av --include="*.dmg" --include="appcast.xml" --include="*.html" --exclude="*" "$1/" user@host:/var/www/feather/'
UPLOAD_COMMAND=""
